# Directus (filisol) är lexikonets databas. Token ska tillhöra API-användaren
# sol-frontend@lb.se, som bara har läsrätt och ingen app-access.
# Skapas om med: node scripts/directus-access.mjs
NUXT_DIRECTUS_URL=https://filisol.lb.se
NUXT_DIRECTUS_TOKEN=

# OpenSearch för fritextsökningen. Interna ingången proxar till klustret och
# lägger på autentisering.
NUXT_OPENSEARCH_URL=http://lb-loadbalancer:9200
NUXT_OPENSEARCH_INDEX=littb-live_sol

# Artikelbilderna, som webbläsaren hämtar direkt från Directus filarkiv.
NUXT_PUBLIC_ASSETS_BASE=https://filisol.lb.se/assets/

# Montering under en sökväg, t.ex. /översättarlexikon/
# NUXT_APP_BASE_URL=/översättarlexikon/
